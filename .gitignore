# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare
/.open-next/
/.wrangler/
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

.vercel
.env*

# stray leftover nested build cache (my-app/my-app/.next) — not source, never commit
/my-app/

# stray leftover empty repo scaffold from an earlier attempt — no source, never commit
/auroraflix-frontend/

# local dev server runtime logs
dev-server.log
dev-server-err.log
