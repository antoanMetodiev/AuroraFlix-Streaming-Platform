{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // A stale local copy of this app from before the Cloudflare migration —
    // untracked by git, not part of the build (Next only reads ./app), but
    // "**/*.tsx" above still pulled its pages into type checking, where they
    // resolve "@/..." against THIS app's components and fail on any prop
    // change made here. Excluded rather than deleted; nothing references it.
    "auroraflix-frontend",
    "my-app"
  ]
}
