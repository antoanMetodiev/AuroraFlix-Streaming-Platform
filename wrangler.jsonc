{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumoflix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_ZW5oYW5jZWQtZ25hdC02MTU0LmNsZXJrLmFjY291bnRzLmRldiQ",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
    "NEXT_PUBLIC_SITE_URL": "https://auroraflix.cloud"
  }
  // CLERK_SECRET_KEY is NOT here on purpose — it's a secret, set it with:
  //   npx wrangler secret put CLERK_SECRET_KEY
}
